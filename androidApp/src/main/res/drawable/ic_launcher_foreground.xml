<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon FOREGROUND layer (issue #46): the mesh glyph only, on a
  transparent canvas — no baked-in corners, no background. Launchers mask
  the composed layers into their own shape (circle / squircle / rounded
  square), so the foreground must never contain its own silhouette.

  Geometry is androidApp/branding/reticulum_icon.svg (512-canvas) mapped
  into the 108dp adaptive viewport at scale 0.16875 = (108/512) × 0.8:
  x' = 54 + (x − 256) × s. The 0.8 shrink keeps the glyph's outermost
  extent (node ring at source radius ≈ 179) at ≈ 30.2dp — inside the
  66dp-diameter safe zone (r = 33) with ~3dp breathing room, per the
  adaptive-icon spec and the reporter's padding note.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Hexagon perimeter + hub spokes -->
    <path
        android:strokeColor="#1abc9c"
        android:strokeWidth="0.59"
        android:strokeLineCap="round"
        android:pathData="M54,27 L77.625,40.5 L77.625,67.5 L54,81 L30.375,67.5 L30.375,40.5 Z
            M54,54 L54,27 M54,54 L77.625,40.5 M54,54 L77.625,67.5
            M54,54 L54,81 M54,54 L30.375,67.5 M54,54 L30.375,40.5" />

    <!-- Cross-mesh accent chords -->
    <path
        android:strokeColor="#1abc9c"
        android:strokeWidth="0.59"
        android:strokeAlpha="0.35"
        android:strokeLineCap="round"
        android:pathData="M54,27 L30.375,67.5 M54,27 L77.625,67.5
            M77.625,40.5 L30.375,67.5 M30.375,40.5 L77.625,67.5" />

    <!-- Vertex nodes -->
    <path
        android:fillColor="#1abc9c"
        android:pathData="M51.64,27 a2.36,2.36 0 1,0 4.72,0 a2.36,2.36 0 1,0 -4.72,0 Z
            M75.265,40.5 a2.36,2.36 0 1,0 4.72,0 a2.36,2.36 0 1,0 -4.72,0 Z
            M75.265,67.5 a2.36,2.36 0 1,0 4.72,0 a2.36,2.36 0 1,0 -4.72,0 Z
            M51.64,81 a2.36,2.36 0 1,0 4.72,0 a2.36,2.36 0 1,0 -4.72,0 Z
            M28.015,67.5 a2.36,2.36 0 1,0 4.72,0 a2.36,2.36 0 1,0 -4.72,0 Z
            M28.015,40.5 a2.36,2.36 0 1,0 4.72,0 a2.36,2.36 0 1,0 -4.72,0 Z" />

    <!-- Outer rings on vertex nodes -->
    <path
        android:strokeColor="#7ce9d3"
        android:strokeWidth="0.34"
        android:strokeAlpha="0.6"
        android:pathData="M50.96,27 a3.04,3.04 0 1,0 6.08,0 a3.04,3.04 0 1,0 -6.08,0 Z
            M74.585,40.5 a3.04,3.04 0 1,0 6.08,0 a3.04,3.04 0 1,0 -6.08,0 Z
            M74.585,67.5 a3.04,3.04 0 1,0 6.08,0 a3.04,3.04 0 1,0 -6.08,0 Z
            M50.96,81 a3.04,3.04 0 1,0 6.08,0 a3.04,3.04 0 1,0 -6.08,0 Z
            M27.335,67.5 a3.04,3.04 0 1,0 6.08,0 a3.04,3.04 0 1,0 -6.08,0 Z
            M27.335,40.5 a3.04,3.04 0 1,0 6.08,0 a3.04,3.04 0 1,0 -6.08,0 Z" />

    <!-- Central hub: dark disc with teal ring + core dot -->
    <path
        android:fillColor="#0d2329"
        android:strokeColor="#1abc9c"
        android:strokeWidth="0.675"
        android:pathData="M49.61,54 a4.39,4.39 0 1,0 8.78,0 a4.39,4.39 0 1,0 -8.78,0 Z" />
